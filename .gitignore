# 데이터셋 (공개 데이터, 재현 가능 — 레포에 포함하지 않음)
data/
# EfficientAD 보조 데이터(imagenette ~1.5GB, 첫 실행 시 자동 다운로드)
datasets/

# 실험 산출물 (대용량 원본은 제외, 큐레이션된 results/ 는 추적)
outputs/
*.ckpt
*.pth

# MES 런타임 산출물 (db·히트맵은 재생성 가능 — 뼈대는 추적하되 산출물만 제외)
mes/runtime/*
!mes/runtime/.gitkeep
*.sqlite
*.db

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# 가상환경 / IDE
.venv/
venv/
.idea/
.vscode/
.claude/
